# ==============================================================================
# Sarrera Platform - Environment Variables and Secrets Template
# Copy this file to .env before starting with: docker compose up -d
# ==============================================================================

# Base domain exposed by Caddy (e.g., localhost or ai.company.local)
DOMAIN=localhost

# --- POSTGRESQL DATABASE ---
POSTGRES_USER=platform_admin
POSTGRES_PASSWORD=DBMasterPass2026_ChangeMe
POSTGRES_DB=postgres

# --- MINIO S3 (Object Storage for Langfuse Traces) ---
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password_ChangeMe

# --- LITELLM GATEWAY & CADDY ADMIN PORTAL ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=sk-master-platform-key-change-me
LITELLM_MASTER_KEY=sk-master-platform-key-change-me
STORE_MODEL_IN_DB=True

# --- LANGFUSE OBSERVABILITY ---
NEXTAUTH_SECRET=super_secret_salt_at_least_32_characters_long_change_me
NEXTAUTH_URL=http://localhost:3000
SALT=local_salt_for_keys_change_me
TELEMETRY_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-setup-key
LANGFUSE_SECRET_KEY=sk-lf-setup-key

# --- OPEN WEBUI & AUTHENTICATION ---
OPENWEBUI_SECRET_KEY=openwebui_secret_change_me
ENABLE_LDAP=false
LDAP_SERVER_HOST=ldap://dc.company.local
LDAP_SERVER_PORT=389
LDAP_BASE_DN=DC=company,DC=local
LDAP_USER_DN=CN=Users,DC=company,DC=local
LDAP_SEARCH_FILTER=(sAMAccountName={username})

# --- UPSTREAM INFERENCE COMPUTE NODES (Ollama / vLLM) ---
GPU_PREMIUM_HOST=http://gpu-premium-node:11434
GPU_ENTRY_HOST=http://gpu-entry-node:11434
CPU_CLUSTER_HOST=http://cpu-cluster-node:11434
